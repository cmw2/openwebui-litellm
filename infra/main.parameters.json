{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "useManagedIdentity": {
      "value": "${USE_MANAGED_IDENTITY=false}"
    },
    "azureApiKey": {
      "value": "${AZURE_API_KEY=}"
    },
    "azureApiBase": {
      "value": "${AZURE_API_BASE}"
    },
    "azureApiVersion": {
      "value": "${AZURE_API_VERSION=2024-08-01-preview}"
    },
    "litellmMasterKey": {
      "value": "${LITELLM_MASTER_KEY}"
    }
  }
}
