sights&lt;/b&gt;&lt;br/&gt;&lt;font color="#555555"&gt;Log Analytics workspace&lt;br/&gt;APIM diagnostics&lt;br/&gt;Foundry connection&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;dashed=0;fontSize=11;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#C19C00;" vertex="1" parent="observability"><mxGeometry x="12" y="40" width="120" height="62" as="geometry"/></mxCell><mxCell id="m365" value="&lt;b&gt;Microsoft 365 tenant&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#111827;strokeColor=#038387;fillColor=#F2FCFC;dashed=0;" vertex="1" parent="1"><mxGeometry x="1470" y="235" width="275" height="275" as="geometry"/></mxCell><mxCell id="sharepoint" value='&lt;b&gt;SharePoint document library&lt;/b&gt;&lt;br/&gt;&lt;font color="#555555"&gt;Approved source documents&lt;br/&gt;Sites.Selected + one-site read&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;dashed=0;fontSize=11;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#038387;" vertex="1" parent="m365"><mxGeometry x="35" y="75" width="205" height="85" as="geometry"/></mxCell><mxCell id="operator" value='&lt;b&gt;One-time operator&lt;/b&gt;&lt;br/&gt;&lt;font color="#555555"&gt;Delegated Graph grant&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;dashed=0;fontSize=11;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#038387;" vertex="1" parent="m365"><mxGeometry x="50" y="190" width="175" height="48" as="geometry"/></mxCell><mxCell id="preview-note" value="&lt;b&gt;Preview gate&lt;/b&gt;&lt;br/&gt;Indexed SharePoint and Foundry IQ require customer validation before production use. Indexed content does not itself enforce end-user SharePoint permissions at query time." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FFF8E1;strokeColor=#D4A017;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1465" y="570" width="280" height="125" as="geometry"/></mxCell><mxCell id="citation-note" value="&lt;b&gt;Citation behavior&lt;/b&gt;&lt;br/&gt;Native indexer maps SharePoint web URL to &lt;code&gt;doc_url&lt;/code&gt;. Knowledge-base agent can render that URL in its answer. Foundry automatic citation panels can still show service-generated links." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FFF8E1;strokeColor=#D4A017;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1465" y="720" width="280" height="125" as="geometry"/></mxCell><mxCell id="user-openwebui" value="HTTPS chat request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10.5;fontColor=#111827;labelBackgroundColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=2.5;" edge="1" parent="1" source="user" target="openwebui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="openwebui-litellm" value="OpenAI Responses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10.5;fontColor=#111827;labelBackgroundColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=2.5;" edge="1" parent="1" source="openwebui" target="litellm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="litellm-apim" value="Responses + APIM product key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10.5;fontColor=#111827;labelBackgroundColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=2.5;" edge="1" parent="1" source="litellm" target="apim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="apim-agents" value="Agent response call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10.5;fontColor=#111827;labelBackgroundColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=2.5;" edge="1" parent="1" source="apim" target="agents"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell