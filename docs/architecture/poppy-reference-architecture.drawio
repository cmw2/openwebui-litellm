<mxfile host="app.diagrams.net"><diagram id="page-1" name="Poppy reference architecture"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1050" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='&lt;b&gt;Poppy reference architecture&lt;/b&gt;&lt;br/&gt;&lt;font color="#555555"&gt;OpenWebUI, LiteLLM, APIM, Microsoft Foundry, Azure AI Search, and SharePoint&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1260" height="52" as="geometry"/></mxCell><mxCell id="user-boundary" value="&lt;b&gt;User boundary&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#111827;strokeColor=#6B7280;fillColor=#F9FAFB;dashed=0;" vertex="1" parent="1"><mxGeometry x="25" y="105" width="235" height="275" as="geometry"/></mxCell><mxCell id="user" value='&lt;b&gt;Authorized user&lt;/b&gt;&lt;br/&gt;&lt;font color="#555555"&gt;Browser&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;dashed=0;fontSize=11;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#6B7280;" vertex="1" parent="user-boundary"><mxGeometry x="35" y="75" width="160" height="75" as="geometry"/></mxCell><mxCell id="subscription" value='&lt;b&gt;Customer Azure subscription&lt;/b&gt;&lt;br/&gt;&lt;font color="#555555"&gt;Core services: customer-selected region; APIM may use a paired region when capacity requires it&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#111827;strokeColor=#0078D4;fillColor=#F4F9FF;dashed=0;" vertex="1" parent="1"><mxGeometry x="295" y="90" width="1120" height="765" as="geometry"/><